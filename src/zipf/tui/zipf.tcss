/* Every colour comes from `theme.py`, which mirrors `dev/tui-mockup-2`.
 * Orange and green are the only hues; neutral surfaces and weight carry every
 * other kind of emphasis. */
Screen {
    background: $background;
    color: $foreground;
}

#status {
    height: 3;
    background: $panel;
}

#explore-bar {
    height: 3;
    align: center middle;
    background: $surface;
    border-bottom: solid $faint;
}

#explore-options {
    width: auto;
}

/* The brand and the balance take equal shares of whatever the blocks leave, so
 * the blocks land in the true middle of the bar — and stay there. Sizing either
 * side to its own text would move the blocks every time the title changed
 * length, which is exactly what cycling sections does. */
#brand {
    width: 1fr;
    padding: 1 1;
}

#sections {
    width: auto;
    padding: 1 0;
}

/* An equal share, but never less than the readout needs. Below about a hundred
 * columns there is not enough bar for both a centred strip and an intact
 * balance, and a truncated figure is worse than an off-centre one. */
#balance {
    width: 1fr;
    min-width: 38;
    padding: 1 1;
    text-align: right;
}

#body {
    height: 1fr;
    background: $surface;
}

#main {
    width: 1fr;
    background: $surface;
}

/* The question this view answers, with the caption beside it. One line: it is
 * orientation, not content, and a second line would push the table down. */
#head {
    height: 1;
    background: $surface;
}

#question {
    width: 1fr;
    padding: 0 1;
}

/* A view's hint always names a command that can cost money, so it wears the
 * spend register. Right-aligned to keep it off the question it sits beside. */
#hint {
    width: auto;
    padding: 0 1;
    color: $spend;
    text-align: right;
}

#workspace {
    height: 1fr;
}

/* The table takes whatever the inspector does not. */
#rows {
    width: 1fr;
    height: 1fr;
}

/* A share of the width rather than a fixed column: at 80 columns a fixed 40
 * would leave the table narrower than the inspector beside it. The bounds keep
 * it readable at both ends — never so narrow that "labs.domain_intersection"
 * wraps, never so wide that it is mostly padding.
 *
 * Its width does not depend on the row under the cursor, so the table's columns
 * do not shift as you move between keywords with more or fewer known surfaces. */
#inspector {
    width: 34%;
    min-width: 26;
    max-width: 44;
    height: 1fr;
    border: solid $faint;
    background: $surface;
}

#detail {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

/* Fixed height so a finished job appearing never resizes the detail above it. */
#jobs {
    width: 1fr;
    height: 9;
    border-top: solid $faint;
    padding: 0 1;
}

/* A compact terminal needs the table's columns more than it needs a second
 * pane beside them. Stack the selected row's detail below the full-width table
 * and bound it so the table still has useful vertical space at 24 rows. */
Screen.-compact #workspace {
    layout: vertical;
}

Screen.-compact #inspector {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    height: 9;
}

Screen.-compact #jobs {
    height: 2;
}

/* Sits below the detail pane and takes one line, so opening it never reflows
 * the table out from under the row you were looking at. */
#filter, #command {
    height: 1;
    border: none;
    padding: 0 1;
    background: $panel;
    color: $foreground;
}

/* The command bar is the only route to a paid action, so it wears the spend
 * register even before a price is named. */
#command {
    color: $spend;
    width: 1fr;
}

/* One row, so the price and the command being typed are read together. */
#command-row {
    height: 1;
    background: $panel;
}

/* The verdict rides on the right of the bar: what this command would do, in one
 * line, updated on every keystroke. Its register is the only thing that makes
 * a paid command look different from a free one before enter is pressed. */
#verdict {
    width: auto;
    max-width: 60%;
    padding: 0 1;
    text-align: right;
    background: $panel;
}

#verdict.-spend {
    color: $spend;
    text-style: bold;
}

#verdict.-free {
    color: $free;
}

#verdict.-error {
    color: $bright;
}

#verdict.-info, #verdict.-idle {
    color: $dim;
}

/* What the typed command would do, priced on every keystroke.
 *
 * Sits directly above the command bar so the bill and the thing being typed are
 * read together. Height is automatic and it is hidden when the bar is closed:
 * a preview of nothing is chrome, and this interface does not keep chrome.
 *
 * The register decides the colour, and this is the only place that mapping
 * exists. `-spend` is the reserved one; nothing else may resolve to $spend. */
#plan {
    height: auto;
    max-height: 6;
    padding: 0 1;
    background: $plan;
}

#plan.-spend {
    color: $spend;
}

#plan.-free {
    color: $free;
}

#plan.-error {
    color: $bright;
}

#plan.-info, #plan.-idle {
    color: $dim;
}

ConfirmModal {
    align: center middle;
}

#confirm {
    width: 52;
    height: auto;
    border: round $spend;
    background: $surface;
    padding: 1 2;
}

#confirm-title {
    color: $spend;
    text-style: bold;
    margin-bottom: 1;
}

#confirm-keys {
    margin-top: 1;
    text-align: right;
}

/* ------------------------------------------------------------------ table */

/* Flat rows with a rule under the header, rather than zebra banding. Striping
 * fills every other row with a colour that means nothing. */
DataTable {
    scrollbar-size: 1 1;
}

DataTable > .datatable--header {
    background: $surface;
    color: $dim;
    text-style: none;
}

DataTable > .datatable--cursor {
    background: $panel;
    color: $bright;
}

DataTable > .datatable--hover {
    background: $hover;
}

/* The identifying column of the row under the cursor, which is the one the
 * inspector beside it is describing. */
DataTable > .datatable--fixed {
    background: $surface;
    color: $dim;
}

/* ----------------------------------------------------------------- footer */

Footer {
    background: $surface;
}

Footer > .footer-key--key {
    background: $surface;
    color: $bright;
}

Footer > .footer-key--description {
    background: $surface;
    color: $dim;
}

/* A rule under the header block, replacing the filled bar that used to
 * separate it from the table. */
#head {
    border-bottom: solid $faint;
}

#status {
    border-bottom: solid $faint;
}

#command-row {
    border-top: solid $faint;
}
